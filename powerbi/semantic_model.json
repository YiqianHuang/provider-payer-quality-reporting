  "measures": [
    {"name": "Facility Count", "home_table": "Dim Facility", "format_string": "#,0", "expression": "DISTINCTCOUNT('Dim Facility'[Facility ID])"},
    {"name": "Reportable Provider Results", "home_table": "Fact Provider Measure", "format_string": "#,0", "expression": "CALCULATE(COUNTROWS('Fact Provider Measure'), 'Fact Provider Measure'[Is Reportable] = TRUE())"},
    {"name": "Suppressed Provider Results", "home_table": "Fact Provider Measure", "format_string": "#,0", "expression": "CALCULATE(COUNTROWS('Fact Provider Measure'), 'Fact Provider Measure'[Is Suppressed] = TRUE())"},
    {"name": "Reportable Result Percent", "home_table": "Fact Provider Measure", "format_string": "0.0%", "expression": "DIVIDE([Reportable Provider Results], COUNTROWS('Fact Provider Measure'))"},
    {"name": "Selected Provider Score", "home_table": "Fact Provider Measure", "format_string": "0.00", "expression": "IF(SELECTEDVALUE('Fact Provider Measure'[Is Reportable]) = TRUE(), SELECTEDVALUE('Fact Provider Measure'[Score]), BLANK())"},
    {"name": "Selected National Benchmark", "home_table": "Fact National Benchmark", "format_string": "0.00", "expression": "SELECTEDVALUE('Fact National Benchmark'[National Rate])"},
    {"name": "Direction Adjusted Gap", "home_table": "Fact Provider Measure", "format_string": "0.00", "expression": "VAR ProviderValue = [Selected Provider Score] VAR BenchmarkValue = [Selected National Benchmark] VAR Direction = SELECTEDVALUE('Dim Measure'[Direction]) RETURN IF(ISBLANK(ProviderValue) || ISBLANK(BenchmarkValue), BLANK(), SWITCH(Direction, \"Lower is better\", BenchmarkValue - ProviderValue, \"Higher is better\", ProviderValue - BenchmarkValue, BLANK()))"},
    {"name": "Better Result Count", "home_table": "Fact Provider Measure", "format_string": "#,0", "expression": "CALCULATE(COUNTROWS('Fact Provider Measure'), 'Fact Provider Measure'[Comparison Category] IN {\"Better than national rate\", \"Better than expected\", \"Fewer days than average\"})"},
    {"name": "Same Result Count", "home_table": "Fact Provider Measure", "format_string": "#,0", "expression": "CALCULATE(COUNTROWS('Fact Provider Measure'), 'Fact Provider Measure'[Comparison Category] IN {\"No different than national rate\", \"No different than expected\", \"Average days\"})"},
    {"name": "Worse Result Count", "home_table": "Fact Provider Measure", "format_string": "#,0", "expression": "CALCULATE(COUNTROWS('Fact Provider Measure'), 'Fact Provider Measure'[Comparison Category] IN {\"Worse than national rate\", \"Worse than expected\", \"More days than average\"})"},
    {"name": "Selected HRRP Excess Ratio", "home_table": "Fact HRRP", "format_string": "0.0000", "expression": "IF(SELECTEDVALUE('Fact HRRP'[Is Reportable]) = TRUE(), SELECTEDVALUE('Fact HRRP'[Excess Readmission Ratio]), BLANK())"},
    {"name": "HRRP Above Expected Count", "home_table": "Fact HRRP", "format_string": "#,0", "expression": "CALCULATE(COUNTROWS('Fact HRRP'), 'Fact HRRP'[Is Reportable] = TRUE(), 'Fact HRRP'[Excess Readmission Ratio] > 1)"},
    {"name": "Selected HVBP TPS", "home_table": "Fact HVBP", "format_string": "0.00", "expression": "IF(SELECTEDVALUE('Fact HVBP'[TPS Reportable]) = TRUE(), SELECTEDVALUE('Fact HVBP'[Total Performance Score]), BLANK())"},
    {"name": "Passed QA Checks", "home_table": "Fact Quality Check", "format_string": "#,0", "expression": "CALCULATE(COUNTROWS('Fact Quality Check'), 'Fact Quality Check'[Status] = \"PASS\")"},
    {"name": "Failed QA Checks", "home_table": "Fact Quality Check", "format_string": "#,0", "expression": "CALCULATE(COUNTROWS('Fact Quality Check'), 'Fact Quality Check'[Status] = \"FAIL\")"}
  ]
}
